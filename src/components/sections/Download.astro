---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface DownloadItem {
	name: string;
	file: string;
	format: string;
	size: string;
	desc: string;
}

interface Props {
	downloads: DownloadItem[];
}

const { downloads } = Astro.props;
---

<section id="download" class="section download">
	<div class="container">
		<SectionHeading
			eyebrow="Material"
			title="Download-Bereich"
			description="Lade unseren Flyer und weiteres Material herunter, um es zu verteilen oder auszudrucken."
		/>
		<div class="downloads-grid reveal-stagger">
			{
				downloads.map((item, i) => (
					<div class="card download-card reveal" style={`--i:${i}`}>
						<div class="download-card__badge">{item.format}</div>
						<h4>{item.name}</h4>
						<p>{item.desc}</p>
						<div class="download-card__footer">
							<span>{item.size}</span>
							<Button href={`${import.meta.env.BASE_URL}${item.file.replace(/^\//, '')}`} download>
								Herunterladen
							</Button>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.download {
		background: var(--paper);
	}

	.downloads-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.download-card {
		padding: 26px;
		position: relative;
	}

	.download-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-pop);
		border-color: var(--green-500);
	}

	.download-card__badge {
		position: absolute;
		top: 22px;
		right: 22px;
		background: var(--green-100);
		color: var(--green-700);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.download-card h4 {
		padding-right: 60px;
		margin-bottom: 8px;
	}

	.download-card p {
		color: var(--ink-soft);
		font-size: 0.92rem;
	}

	.download-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 20px;
	}

	.download-card__footer span {
		color: var(--ink-soft);
		font-size: 0.85rem;
	}

	@media (max-width: 720px) {
		.downloads-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

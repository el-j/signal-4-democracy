---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Divider from '../ui/Divider.astro';
---

<section class="hero">
	<div class="container hero__inner">
		<Eyebrow label="Gemeinsam für eine solidarische Heimat" />
		<h1>Ein Signal <span class="hero__loud">für Demokratie.</span></h1>
		<p class="hero__tagline">Demokratie. Gerechtigkeit. Nachbarschaft.</p>
		<p class="hero__lead">
			Deutschland gibt uns Freiheit, Sicherheit und Lebensqualität – doch diese Errungenschaften sind kein
			Selbstläufer. Rechtsextremismus, soziale Spaltung und Klimakrise bedrohen unser Miteinander. Wir
			handeln jetzt, bevor es zu spät ist.
		</p>
		<div class="hero__actions">
			<Button href="#mitmachen">Jetzt mitmachen</Button>
			<Button href="#download" variant="outline">Flyer herunterladen</Button>
		</div>
		<img src={`${import.meta.env.BASE_URL}logo.svg`} alt="" aria-hidden="true" class="hero__logo" />
		<img src={`${import.meta.env.BASE_URL}logo.svg`} alt="" aria-hidden="true" class="hero__logo hero__logo--two" />
		<a class="hero__scroll" href="#warum" aria-label="Zum nächsten Abschnitt scrollen">
			<span></span>
		</a>
	</div>
	<Divider variant="bottom" />
</section>

<style>
	.hero {
		position: relative;
		background: var(--gradient-loud-soft);
		background-size: 220% 220%;
		animation: hero-gradient 18s ease infinite;
		overflow: hidden;
		padding: 130px 0 40px;
	}

	@keyframes hero-gradient {
		0%,
		100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	.hero__inner {
		position: relative;
		max-width: 760px;
		text-align: center;
		margin: 0 auto;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(2.6rem, 6vw, 4.2rem);
		letter-spacing: -0.01em;
	}

	.hero__loud {
		background: var(--gradient-loud);
		background-size: 200% 200%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: hero-gradient 10s ease infinite;
		display: inline-block;
	}

	.hero__tagline {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--green-700);
		margin-bottom: 22px;
	}

	.hero__lead {
		color: var(--ink-soft);
		font-size: 1.05rem;
		max-width: 620px;
		margin-inline: auto;
	}

	.hero__actions {
		display: flex;
		gap: 16px;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 28px;
	}

	.hero__logo {
		position: absolute;
		top: -20px;
		right: -40px;
		width: 140px;
		opacity: 0.14;
		transform: rotate(8deg);
		pointer-events: none;
		animation: float-rotate 14s ease-in-out infinite;
	}

	.hero__logo--two {
		top: auto;
		right: auto;
		bottom: -10px;
		left: -50px;
		width: 100px;
		opacity: 0.1;
		transform: rotate(-14deg);
		animation-duration: 18s;
		animation-delay: -6s;
	}

	@keyframes float-rotate {
		0%,
		100% {
			transform: translateY(0) rotate(8deg);
		}
		50% {
			transform: translateY(-14px) rotate(14deg);
		}
	}

	.hero__scroll {
		display: inline-flex;
		margin-top: 56px;
		width: 30px;
		height: 46px;
		border: 2px solid var(--green-600);
		border-radius: 999px;
		position: relative;
		opacity: 0.7;
	}

	.hero__scroll span {
		position: absolute;
		top: 8px;
		left: 50%;
		width: 5px;
		height: 5px;
		margin-left: -2.5px;
		border-radius: 50%;
		background: var(--green-600);
		animation: scroll-cue 1.8s ease-in-out infinite;
	}

	@keyframes scroll-cue {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		70% {
			transform: translateY(14px);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 0;
		}
	}

	@media (max-width: 720px) {
		.hero__logo {
			display: none;
		}

		.hero__scroll {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero,
		.hero__loud,
		.hero__logo,
		.hero__scroll span {
			animation: none;
		}
	}
</style>

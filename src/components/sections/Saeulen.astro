---
import SectionHeading from '../ui/SectionHeading.astro';

interface Pillar {
	number: string;
	title: string;
	tagline: string;
	points: string[];
	example: string;
}

interface Props {
	pillars: Pillar[];
}

const { pillars } = Astro.props;
---

<section id="saeulen" class="section saeulen">
	<div class="container">
		<SectionHeading eyebrow="Unsere Strategie" title="3 Säulen für eine starke Demokratie" />
		<div class="pillars reveal-stagger">
			{
				pillars.map((pillar, i) => (
					<article class="card pillar reveal" style={`--i:${i}`}>
						<span class="pillar__number">{pillar.number}</span>
						<h3>{pillar.title}</h3>
						<p class="pillar__tagline">{pillar.tagline}</p>
						<ul>
							{pillar.points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
						<p class="quote">{pillar.example}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.saeulen {
		background: var(--green-50);
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.pillar {
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
	}

	.pillar::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 5px;
		background: var(--gradient-loud);
	}

	.pillar:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-pop);
		border-color: var(--pink-300);
	}

	.pillar__number {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 3rem;
		line-height: 1;
		background: var(--gradient-loud);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		opacity: 0.85;
	}

	.pillar h3 {
		font-size: 1.25rem;
		margin-top: 6px;
	}

	.pillar__tagline {
		color: var(--ink-soft);
		font-style: italic;
		font-size: 0.92rem;
	}

	.pillar ul {
		padding-left: 20px;
		margin: 0 0 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 0.92rem;
	}

	.pillar .quote {
		margin-top: auto;
		font-size: 0.88rem;
	}

	@media (max-width: 980px) {
		.pillars {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import Button from './ui/Button.astro';

const links = [
	{ href: '#warum', label: 'Warum wir handeln' },
	{ href: '#saeulen', label: 'Unsere Säulen' },
	{ href: '#regeln', label: 'Regeln' },
	{ href: '#vision', label: 'Vision 2030' },
	{ href: '#download', label: 'Download' },
];
---

<header class="site-header">
	<div class="signal-stripe" aria-hidden="true"></div>
	<div class="container bar">
		<a class="brand" href="#top">
			<img src={`${import.meta.env.BASE_URL}logo.svg`} alt="Signal für Demokratie Logo" class="brand__logo" />
			<span class="brand__name">Signal für<br />Demokratie</span>
		</a>

		<nav class="nav" aria-label="Hauptnavigation">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<Button href="#mitmachen" class="nav-cta">Mitmachen</Button>

		<input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" />
		<label for="nav-toggle" class="nav-toggle" aria-label="Menü öffnen">
			<span></span>
		</label>

		<nav class="nav-mobile" aria-label="Mobile Navigation">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
			<Button href="#mitmachen">Mitmachen</Button>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 253, 251, 0.75);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid transparent;
		transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.site-header.is-scrolled {
		background: rgba(255, 253, 251, 0.92);
		border-bottom-color: var(--border);
		box-shadow: 0 12px 24px -18px rgba(22, 58, 23, 0.35);
	}

	.signal-stripe {
		height: 4px;
		background: var(--gradient-loud);
		background-size: 200% 100%;
		animation: stripe-shift 6s linear infinite;
	}

	@keyframes stripe-shift {
		to {
			background-position: 200% 0;
		}
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-top: 14px;
		padding-bottom: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		margin-right: auto;
	}

	.brand__logo {
		height: 40px;
		width: auto;
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.brand:hover .brand__logo {
		transform: rotate(-8deg) scale(1.08);
	}

	.brand__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.15;
		color: var(--green-900);
	}

	.nav {
		display: flex;
		gap: 22px;
	}

	.nav a {
		position: relative;
		text-decoration: none;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
		padding-bottom: 2px;
	}

	.nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 100%;
		bottom: -2px;
		height: 2px;
		background: var(--gradient-loud);
		transition: right 0.25s ease;
	}

	.nav a:hover {
		color: var(--green-700);
	}

	.nav a:hover::after {
		right: 0;
	}

	.nav-toggle-input {
		display: none;
	}

	.nav-toggle {
		display: none;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		background: var(--green-100);
	}

	.nav-toggle span,
	.nav-toggle span::before,
	.nav-toggle span::after {
		content: '';
		display: block;
		width: 18px;
		height: 2px;
		background: var(--green-700);
		position: relative;
		transition: 0.2s;
	}

	.nav-toggle span::before {
		position: absolute;
		top: -6px;
	}

	.nav-toggle span::after {
		position: absolute;
		top: 6px;
	}

	.nav-mobile {
		display: none;
	}

	@media (max-width: 860px) {
		.nav,
		.nav-cta {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}

		.nav-mobile {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--paper);
			border-bottom: 1px solid var(--border);
			flex-direction: column;
			padding: 8px 24px 20px;
			gap: 14px;
			display: none;
		}

		.nav-mobile a {
			text-decoration: none;
			color: var(--ink);
			font-weight: 500;
			padding: 6px 0;
		}

		.nav-mobile .btn {
			justify-content: center;
			margin-top: 6px;
		}

		.nav-toggle-input:checked ~ .nav-mobile {
			display: flex;
		}
	}
</style>

---
import Button from './ui/Button.astro';
import locales from '../i18n/locales';
import { DEFAULT_LOCALE, getLocale, getLocaleLabel, localePath } from '../i18n/index';
import { t } from '../i18n/index';

const rootBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const activeLocale = getLocale();
const base = localePath(rootBase, activeLocale);
const languageLabel = t('nav_language');
const brandName = t('brand_name');
const brandWords = brandName.split(' ');
const brandNameLine1 = brandWords.slice(0, -1).join(' ');
const brandNameLine2 = brandWords.slice(-1).join(' ');

const languageOptions = locales.map((code) => ({
	code,
	short: getLocaleLabel(code, activeLocale),
	href: localePath(rootBase, code),
	isActive: code === activeLocale || (code === DEFAULT_LOCALE && activeLocale === DEFAULT_LOCALE),
}));

const links = [
	{ href: `${base}#warum`, label: t('nav_warum') },
	{ href: `${base}#saeulen`, label: t('nav_saeulen') },
	{ href: `${base}#regeln`, label: t('nav_regeln') },
	{ href: `${base}#vision`, label: t('nav_vision') },
	{ href: `${base}#download`, label: t('nav_download') },
];
---

<header class="site-header">
	<div class="signal-stripe" aria-hidden="true"></div>
	<div class="nav-container">
		<a class="brand" href={base}>
			<img src={`${rootBase}logo.svg`} alt={`${brandName} Logo`} class="brand__logo" />
			<span class="brand__name">{brandNameLine1}<br />{brandNameLine2}</span>
		</a>

		<nav class="nav" aria-label={t('nav_aria_main')}>
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<div class="lang-switch" aria-label={languageLabel}>
			{languageOptions.map((option) => (
				<a href={option.href} class:list={{ active: option.isActive }} aria-current={option.isActive ? 'page' : undefined}>
					{option.short}
				</a>
			))}
		</div>

		<Button href={`${base}#mitmachen`} class="nav-cta">{t('nav_cta')}</Button>

		<input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" />
		<label for="nav-toggle" class="nav-toggle" aria-label={t('nav_aria_toggle')}>
			<span></span>
		</label>

		<nav class="nav-mobile" aria-label={t('nav_aria_mobile')}>
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
			<div class="lang-switch lang-switch--mobile" aria-label={languageLabel}>
				{languageOptions.map((option) => (
					<a href={option.href} class:list={{ active: option.isActive }} aria-current={option.isActive ? 'page' : undefined}>
						{option.short}
					</a>
				))}
			</div>
			<Button href={`${base}#mitmachen`}>{t('nav_cta')}</Button>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 253, 251, 0.75);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid transparent;
		transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.site-header.is-scrolled {
		background: rgba(255, 253, 251, 0.92);
		border-bottom-color: var(--border);
		box-shadow: 0 12px 24px -18px rgba(22, 58, 23, 0.35);
	}

	.signal-stripe {
		height: 4px;
		background: var(--gradient-loud);
		background-size: 200% 100%;
		animation: stripe-shift 6s linear infinite;
	}

	@keyframes stripe-shift {
		to {
			background-position: 200% 0;
		}
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		margin-right: auto;
	}

	.brand__logo {
		height: 40px;
		width: auto;
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.brand:hover .brand__logo {
		transform: rotate(-8deg) scale(1.08);
	}

	.brand__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.15;
		color: var(--green-900);
	}

	.nav {
		display: flex;
		gap: 22px;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.8);
	}

	.lang-switch a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 38px;
		height: 30px;
		padding: 0 10px;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		color: var(--ink-soft);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.lang-switch a:hover {
		color: var(--green-700);
	}

	.lang-switch a.active {
		background: var(--green-700);
		color: #fff;
	}

	.nav a {
		position: relative;
		text-decoration: none;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
		padding-bottom: 2px;
	}

	.nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 100%;
		bottom: -2px;
		height: 2px;
		background: var(--gradient-loud);
		transition: right 0.25s ease;
	}

	.nav a:hover {
		color: var(--green-700);
	}

	.nav a:hover::after {
		right: 0;
	}

	.nav-toggle-input {
		display: none;
	}

	.nav-toggle {
		display: none;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		background: var(--green-100);
	}

	.nav-toggle span,
	.nav-toggle span::before,
	.nav-toggle span::after {
		content: '';
		display: block;
		width: 18px;
		height: 2px;
		background: var(--green-700);
		position: relative;
		transition: 0.2s;
	}

	.nav-toggle span::before {
		position: absolute;
		top: -6px;
	}

	.nav-toggle span::after {
		position: absolute;
		top: 6px;
	}

	.nav-mobile {
		display: none;
	}

	@media (max-width: 860px) {
		.nav,
		.nav-cta,
		.lang-switch {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}

		.nav-mobile {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--paper);
			border-bottom: 1px solid var(--border);
			flex-direction: column;
			padding: 8px 24px 20px;
			gap: 14px;
			display: none;
		}

		.nav-mobile a {
			text-decoration: none;
			color: var(--ink);
			font-weight: 500;
			padding: 6px 0;
		}

		.nav-mobile .btn {
			justify-content: center;
			margin-top: 6px;
		}

		.lang-switch--mobile {
			display: inline-flex;
			align-self: flex-start;
		}

		.nav-toggle-input:checked ~ .nav-mobile {
			display: flex;
		}
	}
</style>

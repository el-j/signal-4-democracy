---
interface Props {
	href: string;
	variant?: 'primary' | 'pink' | 'outline';
	download?: boolean;
	class?: string;
}

const { href, variant = 'primary', download = false, class: className } = Astro.props;
const classes = ['btn', `btn--${variant}`, className].filter(Boolean).join(' ');
---

<a class={classes} href={href} download={download}>
	<slot />
</a>

---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Signal für Demokratie — Gemeinsam für eine solidarische Heimat',
	description = 'Demokratie. Gerechtigkeit. Nachbarschaft. Eine Bewegung für eine solidarische Heimat in Deutschland.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
        <script is:inline defer src="https://umami-phi-six-29.vercel.app/script.js" data-website-id="cbdada12-30ce-4fab-87c1-2acb34665cdf"></script>
		<title>{title}</title>
	</head>
	<body>
		<div class="bg-scene" aria-hidden="true">
			<span class="blob blob--a"></span>
			<span class="blob blob--b"></span>
			<span class="blob blob--c"></span>
		</div>
		<slot />
		<script>
			import '../scripts/interactions.js';
		</script>
	</body>
</html>
